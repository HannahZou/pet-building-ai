# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
DATABASE_URL=sqlite:///pawpal.db

# ---- Optional (Week 3)
# PAWPAL_DEFAULT_TIMEZONE=America/New_York
# PAWPAL_PHOTO_DIR=data/photos
# PAWPAL_MAX_PHOTO_MB=5
# PAWPAL_EMAIL_NOTIFICATIONS=true
# Real email (otherwise a mock provider is used and nothing is sent):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# PAWPAL_EMAIL_FROM=care@example.com
